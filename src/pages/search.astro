---
import "../styles/global.css";
import Seo from "../components/Seo.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import items from "../data/generated/portal-items.json";
import streams from "../data/generated/streams.json";
import officialTalents from "../data/generated/official-talents.json";
import { buildTalentProfiles, formatDate } from "../lib/talent-data.mjs";
import { talentSearchTerms } from "../lib/talent-aliases.mjs";
import {
  talentCategoryLabel,
  talentCategoryValue,
} from "../lib/talent-categories.mjs";
import {
  talentBranches,
  talentGroups,
  talentGroupLabels,
  talentGroupValues,
} from "../lib/talent-groups.mjs";
import {
  dataTokenList,
  itemTalentFilterData,
  streamTalentFilterData,
} from "../lib/talent-filter-data.mjs";

const pageDescription =
  "ホロライブ関連の配信、グッズ、公式発表、タレントを横断検索する非公式ページです。";
const base = process.env.BASE_PATH || "/";
const basePath = base.endsWith("/") ? base : `${base}/`;
const sitePath = (path) => `${basePath}${path.replace(/^\/+/, "")}`;

const typeLabels = {
  all: "すべて",
  stream: "配信",
  goods: "グッズ",
  live: "ライブ",
  event: "イベント",
  music: "音楽",
  news: "ニュース",
  talent: "タレント",
};

const streamStatusLabels = {
  live: "配信中",
  upcoming: "予定",
  past: "アーカイブ",
};

function dateLabel(value) {
  if (!value) return "日付未定";
  return formatDate(value);
}

function compactText(parts) {
  return parts
    .flat()
    .filter(Boolean)
    .join(" ")
    .replace(/\s+/g, " ")
    .trim()
    .toLowerCase();
}

function itemType(item) {
  return item.category === "goods" ? "goods" : item.category;
}

const portalResults = items
  .filter((item) => item.category !== "stream")
  .map((item) => {
    const type = itemType(item);
    const talentData = itemTalentFilterData(item);
    return {
      id: item.id,
      type,
      typeLabel: typeLabels[type] || type,
      title: item.title,
      summary: item.summary,
      date: item.startAt,
      url: item.normalUrl || item.officialUrl,
      external: true,
      image: item.imageUrl,
      branches: talentData.branches,
      groups: talentData.groups,
      talents: talentData.talents,
      tags: [
        typeLabels[type],
        ...(item.talents || []).slice(0, 3),
        item.source,
      ],
      search: compactText([
        item.title,
        item.summary,
        item.category,
        item.subcategory,
        item.source,
        item.talents,
        talentSearchTerms(item.talents || []),
      ]),
    };
  });

const streamResults = streams.map((stream) => {
  const talentData = streamTalentFilterData(stream);
  return {
    id: stream.id,
    type: "stream",
    typeLabel: typeLabels.stream,
    title: stream.title,
    summary: `${stream.channelName} ${stream.topic || ""}`.trim(),
    date: stream.startAt,
    url: stream.youtubeUrl,
    external: true,
    image: stream.thumbnailUrl || stream.channelPhoto,
    imageFallback: stream.thumbnailFallbackUrl || stream.channelPhoto,
    branches: talentData.branches,
    groups: talentData.groups,
    talents: talentData.talents,
    tags: [
      streamStatusLabels[stream.status] || "アーカイブ",
      stream.channelName,
      stream.sourceLabel || stream.source,
    ],
    search: compactText([
      stream.title,
      stream.channelName,
      stream.topic,
      stream.status,
      stream.sourceLabel,
      stream.source,
      stream.talents,
      talentSearchTerms([stream.channelName, ...(stream.talents || [])]),
    ]),
  };
});

const talentResults = buildTalentProfiles(items, streams, officialTalents).map(
  (profile) => {
    const category = talentCategoryValue(profile);
    const groups = talentGroupValues(profile);
    return {
      id: `talent-${profile.slug}`,
      type: "talent",
      typeLabel: typeLabels.talent,
      title: profile.name,
      summary: `${profile.counts.total}件 / 配信 ${profile.counts.streams} / グッズ ${profile.counts.goods}`,
      date: profile.latestAt,
      url: sitePath(`talents/${profile.slug}/`),
      external: false,
      image: profile.displayImage,
      branches: [category],
      groups,
      talents: [profile.name],
      tags: [
        talentCategoryLabel(category),
        ...talentGroupLabels(groups),
        ...profile.aliases.slice(0, 2),
      ],
      search: compactText([
        profile.name,
        profile.officialName,
        profile.aliases,
        talentCategoryLabel(category),
        talentGroupLabels(groups),
        category,
        groups,
        talentSearchTerms([
          profile.name,
          profile.officialName,
          ...(profile.aliases || []),
        ]),
      ]),
    };
  },
);

const results = [...streamResults, ...portalResults, ...talentResults].sort(
  (a, b) => (b.date || "").localeCompare(a.date || ""),
);
const typeCounts = results.reduce((acc, result) => {
  acc[result.type] = (acc[result.type] || 0) + 1;
  return acc;
}, {});
const filterTypes = [
  "all",
  "stream",
  "goods",
  "live",
  "event",
  "music",
  "news",
  "talent",
].filter((type) => type === "all" || typeCounts[type] > 0);
const talentBranchCounts = talentResults.reduce((acc, result) => {
  for (const branch of result.branches) {
    acc[branch] = (acc[branch] || 0) + 1;
  }
  return acc;
}, {});
const talentGroupCounts = talentResults.reduce((acc, result) => {
  for (const group of result.groups) {
    acc[group] = (acc[group] || 0) + 1;
  }
  return acc;
}, {});
---

<html lang="ja">
  <head>
    <Seo
      title="検索"
      description={pageDescription}
      path="search/"
      image={results.find((result) => result.image)?.image}
      schemaType="SearchResultsPage"
      jsonLd={{
        about: "hololive portal search",
        numberOfItems: results.length,
      }}
    />
  </head>
  <body>
    <header class="topbar">
      <div class="shell topbar-inner">
        <a class="brand" href="../">
          <span>Holo Portal</span>
        </a>
        <nav class="nav" aria-label="主要ナビゲーション">
          <a href="../">ホーム</a>
          <a href="../streams/">配信</a>
          <a href="../goods/">グッズ</a>
          <a href="../events/">ライブ/イベント</a>
          <a href="../talents/">タレント</a>
          <a href="../search/" aria-current="page">検索</a>
        </nav>
        <ThemeToggle />
      </div>
    </header>

    <main>
      <section class="section">
        <div class="shell">
          <div class="catalog-tools search-tools" aria-label="サイト内検索">
            <input
              class="search-input"
              type="search"
              placeholder="キーワード、タレント名、カテゴリで検索"
              data-site-search
            />
            <label class="select-wrap">
              <span>種類</span>
              <select class="select-input" data-site-type>
                {
                  filterTypes.map((type) => (
                    <option value={type}>
                      {typeLabels[type]} (
                      {type === "all" ? results.length : typeCounts[type]})
                    </option>
                  ))
                }
              </select>
            </label>
            <label class="select-wrap">
              <span>所属</span>
              <select class="select-input" data-site-branch>
                {
                  talentBranches.map((branch) => (
                    <option value={branch.value}>
                      {branch.label} (
                      {branch.value === "all"
                        ? talentResults.length
                        : talentBranchCounts[branch.value] || 0}
                      )
                    </option>
                  ))
                }
              </select>
            </label>
            <label class="select-wrap">
              <span>グループ</span>
              <select class="select-input" data-site-group>
                <option value="all" data-branch="all"
                  >すべて ({talentResults.length})</option
                >
                {
                  talentGroups
                    .filter((group) => group.value !== "all")
                    .map((group) => (
                      <option value={group.value} data-branch={group.branch}>
                        {group.label} ({talentGroupCounts[group.value] || 0})
                      </option>
                    ))
                }
              </select>
            </label>
            <label class="select-wrap">
              <span>タレント</span>
              <select class="select-input" data-site-talent>
                <option value="all" data-branch="all" data-group="all"
                  >すべて</option
                >
                {
                  talentResults.map((result) => (
                    <option
                      value={result.talents[0]}
                      data-branch={result.branches[0]}
                      data-groups={`|${result.groups.join("|")}|`}
                    >
                      {result.talents[0]}
                    </option>
                  ))
                }
              </select>
            </label>
            <div class="result-count" data-site-result-count>
              {results.length}件
            </div>
          </div>
          <div class="empty-state" data-site-empty-state>
            該当する情報が見つかりませんでした。
          </div>
          <div class="list search-results">
            {
              results.map((result) => (
                <a
                  class="list-item card-link search-result"
                  href={result.url}
                  target={result.external ? "_blank" : undefined}
                  rel={result.external ? "noopener noreferrer" : undefined}
                  data-site-result
                  data-type={result.type}
                  data-branches={dataTokenList(result.branches)}
                  data-groups={
                    result.groups ? `|${result.groups.join("|")}|` : ""
                  }
                  data-talents={dataTokenList(result.talents)}
                  data-search={result.search}
                >
                  {result.image ? (
                    <img
                      class="list-thumb"
                      src={result.image}
                      data-fallback-src={result.imageFallback}
                      onerror="if (this.dataset.fallbackSrc && this.src !== this.dataset.fallbackSrc) this.src = this.dataset.fallbackSrc"
                      alt=""
                      loading="lazy"
                      referrerpolicy="no-referrer"
                    />
                  ) : (
                    <span
                      class="list-thumb search-thumb-placeholder"
                      aria-hidden="true"
                    >
                      {result.typeLabel.slice(0, 1)}
                    </span>
                  )}
                  <div class="date">{dateLabel(result.date)}</div>
                  <div>
                    <h2 class="title">{result.title}</h2>
                    <p class="summary">{result.summary}</p>
                    <div class="meta">
                      <span class={`pill ${result.type}`}>
                        {result.typeLabel}
                      </span>
                      {result.tags
                        .filter(Boolean)
                        .slice(0, 4)
                        .map((tag) => (
                          <span class="pill">{tag}</span>
                        ))}
                    </div>
                  </div>
                  <span class="shop-label">
                    {result.external ? "公式へ" : "開く"}
                  </span>
                </a>
              ))
            }
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="shell">
        <p>
          Holo Portal
          は非公式ファンサイトです。検索結果から開く公式情報の内容・販売状況はリンク先で確認してください。
        </p>
      </div>
    </footer>
    <script>
      const searchInput = document.querySelector("[data-site-search]");
      const typeSelect = document.querySelector("[data-site-type]");
      const branchSelect = document.querySelector("[data-site-branch]");
      const groupSelect = document.querySelector("[data-site-group]");
      const talentSelect = document.querySelector("[data-site-talent]");
      const resultCards = [...document.querySelectorAll("[data-site-result]")];
      const resultCount = document.querySelector("[data-site-result-count]");
      const emptyState = document.querySelector("[data-site-empty-state]");

      function setSelectValue(select, value) {
        const hasOption = [...select.options].some(
          (option) => option.value === value && !option.hidden,
        );
        select.value = hasOption ? value : "all";
      }

      function syncGroupOptions() {
        for (const option of groupSelect.options) {
          option.hidden =
            branchSelect.value !== "all" &&
            option.dataset.branch !== "all" &&
            option.dataset.branch !== branchSelect.value;
        }
        if (groupSelect.selectedOptions[0]?.hidden) groupSelect.value = "all";
      }

      function syncTalentOptions() {
        for (const option of talentSelect.options) {
          const branchOk =
            branchSelect.value === "all" ||
            option.dataset.branch === "all" ||
            option.dataset.branch === branchSelect.value;
          const groupOk =
            option.value === "all" ||
            groupSelect.value === "all" ||
            option.dataset.groups?.includes(`|${groupSelect.value}|`);
          option.hidden = !(branchOk && groupOk);
        }
        if (talentSelect.selectedOptions[0]?.hidden) talentSelect.value = "all";
      }

      function applySearch({ updateUrl = true } = {}) {
        const query = searchInput.value.trim().toLowerCase();
        const type = typeSelect.value;
        const branch = branchSelect.value;
        const group = groupSelect.value;
        const talent = talentSelect.value;
        let visible = 0;

        for (const card of resultCards) {
          const matchesText = !query || card.dataset.search.includes(query);
          const matchesType = type === "all" || card.dataset.type === type;
          const matchesBranch =
            branch === "all" || card.dataset.branches.includes(`|${branch}|`);
          const matchesGroup =
            group === "all" || card.dataset.groups.includes(`|${group}|`);
          const matchesTalent =
            talent === "all" || card.dataset.talents.includes(`|${talent}|`);
          const show =
            matchesText &&
            matchesType &&
            matchesBranch &&
            matchesGroup &&
            matchesTalent;
          card.hidden = !show;
          if (show) visible += 1;
        }

        resultCount.textContent = `${visible}件`;
        emptyState.style.display = visible === 0 ? "block" : "none";

        if (updateUrl) {
          const params = new URLSearchParams();
          if (query) params.set("q", query);
          if (type !== "all") params.set("type", type);
          if (branch !== "all") params.set("branch", branch);
          if (group !== "all") params.set("group", group);
          if (talent !== "all") params.set("talent", talent);
          const nextUrl = params.toString() ? `?${params}` : location.pathname;
          history.replaceState(null, "", nextUrl);
        }
      }

      const params = new URLSearchParams(location.search);
      const initialQuery = params.get("q") || "";
      const initialType = params.get("type") || "all";
      searchInput.value = initialQuery;
      if (
        [...typeSelect.options].some((option) => option.value === initialType)
      ) {
        typeSelect.value = initialType;
      }
      setSelectValue(branchSelect, params.get("branch") || "all");
      syncGroupOptions();
      setSelectValue(groupSelect, params.get("group") || "all");
      syncTalentOptions();
      setSelectValue(talentSelect, params.get("talent") || "all");
      applySearch({ updateUrl: false });

      searchInput.addEventListener("input", applySearch);
      typeSelect.addEventListener("change", applySearch);
      branchSelect.addEventListener("change", () => {
        syncGroupOptions();
        syncTalentOptions();
        applySearch();
      });
      groupSelect.addEventListener("change", () => {
        syncTalentOptions();
        applySearch();
      });
      talentSelect.addEventListener("change", applySearch);
    </script>
  </body>
</html>
