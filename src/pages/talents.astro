---
import "../styles/global.css";
import Seo from "../components/Seo.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import items from "../data/generated/portal-items.json";
import streams from "../data/generated/streams.json";
import officialTalents from "../data/generated/official-talents.json";
import { buildTalentProfiles, formatDate } from "../lib/talent-data.mjs";
import {
  talentCategories,
  talentCategoryLabel,
  talentCategoryValue,
} from "../lib/talent-categories.mjs";
import {
  talentGroups,
  talentGroupLabels,
  talentGroupValues,
} from "../lib/talent-groups.mjs";

const talents = buildTalentProfiles(items, streams, officialTalents).map(
  (talent) => {
    const category = talentCategoryValue(talent);
    const groups = talentGroupValues(talent);
    return {
      ...talent,
      category,
      categoryLabel: talentCategoryLabel(category),
      groups,
      groupLabels: talentGroupLabels(groups),
    };
  },
);
const categoryCounts = talents.reduce((acc, talent) => {
  acc[talent.category] = (acc[talent.category] || 0) + 1;
  return acc;
}, {});
const groupCounts = talents.reduce((acc, talent) => {
  for (const group of talent.groups) {
    acc[group] = (acc[group] || 0) + 1;
  }
  return acc;
}, {});
const pageDescription =
  "ホロライブ関連情報をタレント別に整理する非公式ページです。";
const base = process.env.BASE_PATH || "/";
const basePath = base.endsWith("/") ? base : `${base}/`;
const sitePath = (path) => `${basePath}${path.replace(/^\/+/, "")}`;
---

<html lang="ja">
  <head>
    <Seo
      title="タレント"
      description={pageDescription}
      path="talents/"
      image={talents.find((talent) => talent.displayImage)?.displayImage}
      schemaType="CollectionPage"
      jsonLd={{
        about: "hololive talents",
        numberOfItems: talents.length,
      }}
    />
  </head>
  <body>
    <header class="topbar">
      <div class="shell topbar-inner">
        <a class="brand" href="../">
          <span>Holo Portal</span>
        </a>
        <nav class="nav" aria-label="主要ナビゲーション">
          <a href="../">ホーム</a>
          <a href="../streams/">配信</a>
          <a href="../goods/">グッズ</a>
          <a href="../events/">ライブ/イベント</a>
          <a href="../music/">音楽</a>
          <a href="../talents/" aria-current="page">タレント</a>
          <a href="../search/">検索</a>
        </nav>
        <ThemeToggle />
      </div>
    </header>

    <main>
      <section class="section">
        <div class="shell">
          <div class="catalog-tools talent-tools" aria-label="タレント検索">
            <input
              class="search-input"
              type="search"
              placeholder="タレント名・チャンネル名で検索"
              data-talent-search
            />
            <label class="select-wrap">
              <span>所属</span>
              <select class="select-input" data-talent-branch>
                {
                  talentCategories.map((category) => (
                    <option value={category.value}>
                      {category.label} (
                      {category.value === "all"
                        ? talents.length
                        : categoryCounts[category.value] || 0}
                      )
                    </option>
                  ))
                }
              </select>
            </label>
            <label class="select-wrap">
              <span>グループ</span>
              <select class="select-input" data-talent-group>
                <option value="all" data-branch="all"
                  >すべて ({talents.length})</option
                >
                {
                  talentGroups
                    .filter((group) => group.value !== "all")
                    .map((group) => (
                      <option value={group.value} data-branch={group.branch}>
                        {group.label} ({groupCounts[group.value] || 0})
                      </option>
                    ))
                }
              </select>
            </label>
            <label class="select-wrap">
              <span>タレント</span>
              <select class="select-input" data-talent-name>
                <option value="all" data-branch="all" data-group="all"
                  >すべて</option
                >
                {
                  talents.map((talent) => (
                    <option
                      value={talent.name}
                      data-branch={talent.category}
                      data-groups={`|${talent.groups.join("|")}|`}
                    >
                      {talent.name}
                    </option>
                  ))
                }
              </select>
            </label>
            <div class="result-count" data-talent-result-count>
              {talents.length}件
            </div>
          </div>
          <div class="empty-state" data-talent-empty-state>
            該当するタレントが見つかりませんでした。
          </div>
          <div class="grid">
            {
              talents.map((talent) => (
                <a
                  class="card card-link"
                  href={sitePath(`talents/${talent.slug}/`)}
                  data-talent-card
                  data-category={talent.category}
                  data-groups={`|${talent.groups.join("|")}|`}
                  data-name={talent.name}
                  data-search={`${talent.name} ${talent.aliases.join(" ")}`.toLowerCase()}
                >
                  {talent.displayImage && (
                    <div class="thumb-wrap">
                      <img
                        class="thumb talent-thumb"
                        src={talent.displayImage}
                        alt={`${talent.name} 公式プロフィール画像`}
                        loading="lazy"
                        referrerpolicy="no-referrer"
                      />
                      {talent.officialImage && (
                        <span class="image-credit">公式プロフィール</span>
                      )}
                    </div>
                  )}
                  <div class="card-body">
                    <div class="date">
                      {talent.counts.total} 件 / 最新{" "}
                      {formatDate(talent.latestAt)}
                    </div>
                    <h2 class="title">{talent.name}</h2>
                    {talent.aliases.length > 0 && (
                      <p class="summary">
                        {talent.aliases.slice(0, 3).join(" / ")}
                      </p>
                    )}
                    <div class="meta">
                      <span class="pill category">{talent.categoryLabel}</span>
                      {talent.groupLabels.map((label) => (
                        <span class="pill">{label}</span>
                      ))}
                      {talent.counts.streams > 0 && (
                        <span class="pill live">
                          配信 {talent.counts.streams}
                        </span>
                      )}
                      {talent.counts.goods > 0 && (
                        <span class="pill goods">
                          グッズ {talent.counts.goods}
                        </span>
                      )}
                      {talent.counts.events > 0 && (
                        <span class="pill event">
                          発表 {talent.counts.events}
                        </span>
                      )}
                      {talent.counts.news > 0 && (
                        <span class="pill">ニュース {talent.counts.news}</span>
                      )}
                      <span class="shop-label">まとめを見る</span>
                    </div>
                  </div>
                </a>
              ))
            }
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="shell">
        <p>
          Holo Portal
          は非公式ファンサイトです。タレント画像は公式プロフィールページの画像URLを参照し、保存・再配布はしていません。名前検出は自動処理のため、関連情報が抜ける場合があります。
        </p>
      </div>
    </footer>
    <script>
      const talentSearch = document.querySelector("[data-talent-search]");
      const talentBranch = document.querySelector("[data-talent-branch]");
      const talentGroup = document.querySelector("[data-talent-group]");
      const talentName = document.querySelector("[data-talent-name]");
      const talentCards = [...document.querySelectorAll("[data-talent-card]")];
      const talentResultCount = document.querySelector(
        "[data-talent-result-count]",
      );
      const talentEmptyState = document.querySelector(
        "[data-talent-empty-state]",
      );

      function setQueryParam(params, key, value, defaultValue = "") {
        if (!value || value === defaultValue) params.delete(key);
        else params.set(key, value);
      }

      function updateTalentsUrl() {
        const url = new URL(window.location.href);
        setQueryParam(url.searchParams, "q", talentSearch.value.trim());
        setQueryParam(url.searchParams, "branch", talentBranch.value, "all");
        setQueryParam(url.searchParams, "group", talentGroup.value, "all");
        setQueryParam(url.searchParams, "talent", talentName.value, "all");
        window.history.replaceState(
          {},
          "",
          `${url.pathname}${url.search}${url.hash}`,
        );
      }

      function setSelectValue(select, value) {
        const hasOption = [...select.options].some(
          (option) => option.value === value && !option.hidden,
        );
        select.value = hasOption ? value : "all";
      }

      function syncGroupOptions() {
        for (const option of talentGroup.options) {
          option.hidden =
            talentBranch.value !== "all" &&
            option.dataset.branch !== "all" &&
            option.dataset.branch !== talentBranch.value;
        }
        if (talentGroup.selectedOptions[0]?.hidden) talentGroup.value = "all";
      }

      function syncTalentOptions() {
        for (const option of talentName.options) {
          const branchOk =
            talentBranch.value === "all" ||
            option.dataset.branch === "all" ||
            option.dataset.branch === talentBranch.value;
          const groupOk =
            option.value === "all" ||
            talentGroup.value === "all" ||
            option.dataset.groups?.includes(`|${talentGroup.value}|`);
          option.hidden = !(branchOk && groupOk);
        }
        if (talentName.selectedOptions[0]?.hidden) talentName.value = "all";
      }

      function applyTalentSearch() {
        const query = talentSearch.value.trim().toLowerCase();
        const branch = talentBranch.value;
        const group = talentGroup.value;
        const selectedTalent = talentName.value;
        let visible = 0;
        for (const card of talentCards) {
          const matchesText = !query || card.dataset.search.includes(query);
          const matchesBranch =
            branch === "all" || card.dataset.category === branch;
          const matchesGroup =
            group === "all" || card.dataset.groups.includes(`|${group}|`);
          const matchesTalent =
            selectedTalent === "all" || card.dataset.name === selectedTalent;
          const show =
            matchesText && matchesBranch && matchesGroup && matchesTalent;
          card.hidden = !show;
          if (show) visible += 1;
        }
        talentResultCount.textContent = `${visible}件`;
        talentEmptyState.style.display = visible === 0 ? "block" : "none";
      }

      function applyTalentStateFromUrl() {
        const params = new URLSearchParams(window.location.search);
        talentSearch.value = params.get("q") || "";
        setSelectValue(
          talentBranch,
          params.get("branch") || params.get("category") || "all",
        );
        syncGroupOptions();
        setSelectValue(talentGroup, params.get("group") || "all");
        syncTalentOptions();
        setSelectValue(talentName, params.get("talent") || "all");
        applyTalentSearch();
      }

      talentSearch.addEventListener("input", () => {
        applyTalentSearch();
        updateTalentsUrl();
      });
      talentBranch.addEventListener("change", () => {
        syncGroupOptions();
        syncTalentOptions();
        applyTalentSearch();
        updateTalentsUrl();
      });
      talentGroup.addEventListener("change", () => {
        syncTalentOptions();
        applyTalentSearch();
        updateTalentsUrl();
      });
      talentName.addEventListener("change", () => {
        applyTalentSearch();
        updateTalentsUrl();
      });
      window.addEventListener("popstate", applyTalentStateFromUrl);
      applyTalentStateFromUrl();
    </script>
  </body>
</html>
