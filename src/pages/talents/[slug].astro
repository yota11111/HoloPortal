---
import "../../styles/global.css";
import Seo from "../../components/Seo.astro";
import ThemeToggle from "../../components/ThemeToggle.astro";
import items from "../../data/generated/portal-items.json";
import streams from "../../data/generated/streams.json";
import officialTalents from "../../data/generated/official-talents.json";
import {
  buildTalentProfiles,
  formatDate,
  formatDateTime,
  itemLabels,
} from "../../lib/talent-data.mjs";

export function getStaticPaths() {
  const profiles = buildTalentProfiles(items, streams, officialTalents);
  return profiles.map((profile) => ({
    params: { slug: profile.slug },
    props: { profile },
  }));
}

const { profile } = Astro.props;
const liveStreams = profile.streams.filter(
  (stream) => stream.status === "live",
);
const upcomingStreams = profile.streams.filter(
  (stream) => stream.status === "upcoming",
);
const archiveStreams = profile.streams
  .filter((stream) => stream.status !== "live" && stream.status !== "upcoming")
  .slice(0, 12);
const goodsItems = profile.items
  .filter((item) => item.category === "goods")
  .slice(0, 12);
const announcementItems = profile.items
  .filter((item) => item.category !== "goods")
  .slice(0, 12);
const announcementCount = profile.counts.news + profile.counts.events;
const recentItems = [...profile.streams, ...profile.items]
  .sort((a, b) => (b.startAt || "").localeCompare(a.startAt || ""))
  .slice(0, 8);
const pageDescription = `${profile.name} の配信、グッズ、公式発表を整理する非公式ページです。`;

function streamStatusLabel(status) {
  if (status === "live") return "配信中";
  if (status === "upcoming") return "予定";
  return "アーカイブ";
}
---

<html lang="ja">
  <head>
    <Seo
      title={profile.name}
      description={pageDescription}
      path={`talents/${profile.slug}/`}
      image={profile.displayImage}
      schemaType="ProfilePage"
      jsonLd={{
        mainEntity: {
          "@type": "Thing",
          name: profile.name,
          alternateName: profile.aliases,
          image: profile.displayImage,
        },
      }}
    />
  </head>
  <body>
    <header class="topbar">
      <div class="shell topbar-inner">
        <a class="brand" href="../../">
          <span>Holo Portal</span>
        </a>
        <nav class="nav" aria-label="主要ナビゲーション">
          <a href="../../">ホーム</a>
          <a href="../../streams/">配信</a>
          <a href="../../goods/">グッズ</a>
          <a href="../../events/">ライブ/イベント</a>
          <a href="../" aria-current="page">タレント</a>
          <a href="../../search/">検索</a>
        </nav>
        <ThemeToggle />
      </div>
    </header>

    <main>
      <section class="section">
        <div class="shell">
          <div class="profile-summary">
            {profile.displayImage && (
              <div class="profile-image">
                <img
                  src={profile.displayImage}
                  alt={`${profile.name} プロフィール画像`}
                  loading="lazy"
                  referrerpolicy="no-referrer"
                />
              </div>
            )}
            <div class="profile-summary-body">
              <div class="date">タレント別まとめ</div>
              <h1>{profile.name} のまとめ</h1>
              {profile.aliases.length > 0 && (
                <p class="summary">{profile.aliases.slice(0, 5).join(" / ")}</p>
              )}
              <div class="meta">
                <span class="pill">合計 {profile.counts.total}件</span>
                <span class="pill live">配信 {profile.counts.streams}件</span>
                <span class="pill goods">グッズ {profile.counts.goods}件</span>
                <span class="pill event">発表 {announcementCount}件</span>
                {profile.officialUrl && (
                  <a
                    class="shop-label"
                    href={profile.officialUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    公式プロフィール
                  </a>
                )}
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="shell">
          <div class="section-head">
            <h2>最近の更新</h2>
            <span class="section-note">{recentItems.length}件</span>
          </div>
          {recentItems.length === 0 && (
            <div class="empty-state visible">最近の更新はまだありません。</div>
          )}
          {recentItems.length > 0 && <div class="list">
            {
              recentItems.map((item) => (
                <a
                  class="list-item card-link"
                  href={item.youtubeUrl || item.normalUrl || item.officialUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {(item.thumbnailUrl ||
                    item.imageUrl ||
                    item.channelPhoto) && (
                    <img
                      class="list-thumb"
                      src={
                        item.thumbnailUrl || item.imageUrl || item.channelPhoto
                      }
                      data-fallback-src={item.thumbnailFallbackUrl || item.channelPhoto}
                      onerror="if (this.dataset.fallbackSrc && this.src !== this.dataset.fallbackSrc) this.src = this.dataset.fallbackSrc"
                      alt=""
                      loading="lazy"
                      referrerpolicy="no-referrer"
                    />
                  )}
                  <div class="date">
                    {item.youtubeUrl
                      ? formatDateTime(item.startAt)
                      : formatDate(item.startAt)}
                  </div>
                  <div>
                    <h3 class="title">{item.title}</h3>
                    <p class="summary">{item.channelName || item.summary}</p>
                    <div class="meta">
                      <span class={`pill ${item.category || item.status}`}>
                        {item.youtubeUrl
                          ? streamStatusLabel(item.status)
                          : itemLabels[item.category] || item.category}
                      </span>
                      {item.topic && <span class="pill">{item.topic}</span>}
                      {item.sourceLabel && (
                        <span class="pill">{item.sourceLabel}</span>
                      )}
                    </div>
                  </div>
                  <span class="button">
                    {item.youtubeUrl ? "YouTubeで見る" : "公式へ"}
                  </span>
                </a>
              ))
            }
          </div>}
        </div>
      </section>

          <section class="section">
            <div class="shell">
              <div class="section-head">
                <h2>配信中・配信予定</h2>
                <span class="section-note">
                  {liveStreams.length + upcomingStreams.length}件
                </span>
              </div>
              {liveStreams.length + upcomingStreams.length === 0 && (
                <div class="empty-state visible">配信中・配信予定はありません。</div>
              )}
              {liveStreams.length + upcomingStreams.length > 0 && <div class="grid">
                {[...liveStreams, ...upcomingStreams].map((stream) => (
                  <a
                    class="card card-link"
                    href={stream.youtubeUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <div class="thumb-wrap">
                      <img
                        class="thumb stream-thumb"
                        src={stream.thumbnailUrl}
                        data-fallback-src={stream.thumbnailFallbackUrl}
                        onerror="if (this.dataset.fallbackSrc && this.src !== this.dataset.fallbackSrc) this.src = this.dataset.fallbackSrc"
                        alt=""
                        loading="lazy"
                        referrerpolicy="no-referrer"
                      />
                      <span
                        class={`image-credit ${stream.status === "live" ? "is-live" : ""}`}
                      >
                        {streamStatusLabel(stream.status)}
                      </span>
                    </div>
                    <div class="card-body">
                      <div class="date">{formatDateTime(stream.startAt)}</div>
                      <h3 class="title">{stream.title}</h3>
                      <p class="summary">{stream.channelName}</p>
                      <div class="meta">
                        <span class="pill live">
                          {streamStatusLabel(stream.status)}
                        </span>
                        {stream.liveViewers && (
                          <span class="pill">
                            {stream.liveViewers.toLocaleString("ja-JP")}
                            人が視聴中
                          </span>
                        )}
                        {stream.topic && (
                          <span class="pill">{stream.topic}</span>
                        )}
                        <span class="button">YouTubeで見る</span>
                      </div>
                    </div>
                  </a>
                ))}
              </div>}
            </div>
          </section>

          <section class="section">
            <div class="shell">
              <div class="section-head">
                <h2>グッズ</h2>
                <span class="section-note">{profile.counts.goods}件</span>
              </div>
              {goodsItems.length === 0 && (
                <div class="empty-state visible">グッズはまだありません。</div>
              )}
              {goodsItems.length > 0 && <div class="grid">
                {goodsItems.map((item) => (
                  <a
                    class="card card-link"
                    href={item.normalUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {item.imageUrl && (
                      <div class="thumb-wrap">
                        <img
                          class="thumb"
                          src={item.imageUrl}
                          alt=""
                          loading="lazy"
                          referrerpolicy="no-referrer"
                        />
                        <span class="image-credit">公式</span>
                      </div>
                    )}
                    <div class="card-body">
                      <div class="date">{formatDate(item.startAt)}</div>
                      <h3 class="title">{item.title}</h3>
                      <p class="summary">{item.summary}</p>
                      <div class="meta">
                        <span class="pill goods">グッズ</span>
                        <span class="button">公式ショップ</span>
                      </div>
                    </div>
                  </a>
                ))}
              </div>}
            </div>
          </section>

          <section class="section">
            <div class="shell">
              <div class="section-head">
                <h2>公式発表</h2>
                <span class="section-note">{announcementCount}件</span>
              </div>
              {announcementItems.length === 0 && (
                <div class="empty-state visible">公式発表はまだありません。</div>
              )}
              {announcementItems.length > 0 && <div class="list">
                {announcementItems.map((item) => (
                  <a
                    class="list-item card-link"
                    href={item.normalUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {item.imageUrl && (
                      <img
                        class="list-thumb"
                        src={item.imageUrl}
                        alt=""
                        loading="lazy"
                        referrerpolicy="no-referrer"
                      />
                    )}
                    <div class="date">{formatDate(item.startAt)}</div>
                    <div>
                      <h3 class="title">{item.title}</h3>
                      <p class="summary">{item.summary}</p>
                      <div class="meta">
                        <span class={`pill ${item.category}`}>
                          {itemLabels[item.category] || item.category}
                        </span>
                      </div>
                    </div>
                    <span class="button">公式へ</span>
                  </a>
                ))}
              </div>}
            </div>
          </section>

          <section class="section">
            <div class="shell">
              <div class="section-head">
                <h2>アーカイブ</h2>
                <span class="section-note">{archiveStreams.length}件</span>
              </div>
              {archiveStreams.length === 0 && (
                <div class="empty-state visible">アーカイブはまだありません。</div>
              )}
              {archiveStreams.length > 0 && <div class="grid">
                {archiveStreams.map((stream) => (
                  <a
                    class="card card-link"
                    href={stream.youtubeUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <div class="thumb-wrap">
                      <img
                        class="thumb stream-thumb"
                        src={stream.thumbnailUrl}
                        data-fallback-src={stream.thumbnailFallbackUrl}
                        onerror="if (this.dataset.fallbackSrc && this.src !== this.dataset.fallbackSrc) this.src = this.dataset.fallbackSrc"
                        alt=""
                        loading="lazy"
                        referrerpolicy="no-referrer"
                      />
                      <span class="image-credit">
                        {streamStatusLabel(stream.status)}
                      </span>
                    </div>
                    <div class="card-body">
                      <div class="date">{formatDateTime(stream.startAt)}</div>
                      <h3 class="title">{stream.title}</h3>
                      <p class="summary">{stream.channelName}</p>
                      <div class="meta">
                        <span class="pill">
                          {stream.sourceLabel || stream.source}
                        </span>
                        <span class="button">YouTubeで見る</span>
                      </div>
                    </div>
                  </a>
                ))}
              </div>}
            </div>
          </section>
    </main>

    <footer class="footer">
      <div class="shell">
        <p>
          Holo Portal
          は非公式ファンサイトです。タレント画像は公式プロフィールページの画像URLを参照し、保存・再配布はしていません。タレント関連付けは自動処理のため、抜けや重複が出る場合があります。
        </p>
      </div>
    </footer>
  </body>
</html>
