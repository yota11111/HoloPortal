---
import links from "../data/links.json";

const {
  class: className = "notice"
} = Astro.props;

const affiliateEnabled = links.affiliateEnabled === true;
const disclosure = affiliateEnabled
  ? links.affiliateDisclosure
  : links.disclosure;
---

{disclosure && (
  <p class={className} data-affiliate-disclosure data-affiliate-enabled={String(affiliateEnabled)}>
    {disclosure}
  </p>
)}
