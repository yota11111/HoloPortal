# Optional: enrich stream data with Holodex metadata.
# Get a key from Holodex Account Settings and set the same name in GitHub Repository Secrets.
HOLODEX_API_KEY=

# Optional: tune external fetch timeout in milliseconds.
FETCH_TIMEOUT_MS=15000

