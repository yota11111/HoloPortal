# Optional: enrich stream data with Holodex metadata.
# Get a key from Holodex Account Settings and set the same name in GitHub Repository Secrets.
HOLODEX_API_KEY=

# Optional: tune external fetch timeout in milliseconds.
FETCH_TIMEOUT_MS=15000

# Production deployment values are set automatically in GitHub Actions for GitHub Pages.
# SITE_URL=https://example.com
# BASE_PATH=/

# Optional: post a daily digest to X.
# Keep disabled until the X app has Read and Write permissions and access tokens are regenerated.
# See docs/x-api.md.
X_POST_ENABLED=false
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
